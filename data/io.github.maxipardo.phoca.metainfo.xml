<component type="desktop-application">
    <id>io.github.maxipardo.phoca</id>

    <name>Phoca</name>
    <summary>Download videos and audio from the web</summary>

    <developer id="io.github.maxipardo">
        <name>Máximo Pardo</name>
    </developer>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>

    <description>
        <p>Phoca provides a clean and intuitive interface to grab media from hundreds of supported sites.</p>
        <p>Features include:</p>
        <ul>
            <li>Download video, audio, or both simultaneously</li>
            <li>Convert files to your preferred format (MP4, MKV, WebM, MP3, FLAC, WAV, and more)</li>
            <li>Download entire playlists</li>
            <li>Save thumbnails, subtitles and metadata</li>
            <li>Use browser cookies for accessing restricted content</li>
            <li>Drag and drop downloaded items for a better workflow</li>
        </ul>
    </description>

    <launchable type="desktop-id">io.github.maxipardo.phoca.desktop</launchable>

    <url type="homepage">https://github.com/maxipardo/Phoca</url>
    <url type="bugtracker">https://github.com/maxipardo/Phoca/issues</url>
    <url type="vcs-browser">https://github.com/maxipardo/Phoca</url>

    <branding>
        <color type="primary" scheme_preference="light">#62a0ea</color>
        <color type="primary" scheme_preference="dark">#1a5fb4</color>
    </branding>

    <screenshots>
        <screenshot type="default">
            <caption xml:lang="en">Main application window</caption>
            <image xml:lang="en">https://raw.githubusercontent.com/maxipardo/Phoca/main/screenshots/flatpak_screenshot1.png</image>
        </screenshot>
        <screenshot>
            <caption xml:lang="en">Application in dark mode</caption>
            <image xml:lang="en">https://raw.githubusercontent.com/maxipardo/Phoca/main/screenshots/flatpak_screenshot2.png</image>
        </screenshot>
    </screenshots>

    <content_rating type="oars-1.1" />

    <categories>
        <category>Utility</category>
        <category>Network</category>
    </categories>

    <keywords>
        <keyword>video</keyword>
        <keyword>audio</keyword>
        <keyword>download</keyword>
        <keyword>downloader</keyword>
        <keyword>yt-dlp</keyword>
        <keyword>youtube</keyword>
        <keyword>media</keyword>
        <keyword>converter</keyword>
    </keywords>

    <releases>
        <release version="0.6-alpha" date="2026-10-03">
            <description>
                <p>New features and improvements in this release:</p>
                <ul>
                    <li>Added custom yt-dlp options dialog for advanced download flags.</li>
                    <li>Added SponsorBlock categories support with skip/mark actions.</li>
                    <li>Added metadata embedding option for audio downloads.</li>
                    <li>Added quality/bitrate options for audio downloads.</li>
                    <li>Added more keyboard shortcuts.</li>
                    <li>Added audio-only and video-only downloads icon indicators.</li>
                    <li>Added dedicated save thumbnail action in the download list.</li>
                    <li>Fixed retry, cancel, and update behavior to avoid stale states and improve reliability.</li>
                    <li>Enhanced stalled-download detection, progress reporting, and download status updates.</li>
                </ul>
            </description>
        </release>
    </releases>

    <requires>
        <display_length compare="ge">360</display_length>
    </requires>

    <supports>
        <control>pointing</control>
        <control>keyboard</control>
    </supports>
</component>
